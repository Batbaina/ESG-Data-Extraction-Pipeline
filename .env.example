# ==========================================
# MODEL / OLLAMA
# ==========================================
ESG_MODEL=qwen3:8b
ESG_OLLAMA_URL=http://localhost:11434
ESG_REQUEST_TIMEOUT_SECONDS=240

# ==========================================
# PROMPT VERSION
# ==========================================
ESG_PROMPT_VERSION=v1

# ==========================================
# GENERATION / REPRODUCIBILITY
# ==========================================
ESG_TEMPERATURE=0.0
ESG_TOP_P=0.9
ESG_TOP_K=40
ESG_SEED=42
ESG_NUM_CTX=8192
ESG_NUM_PREDICT=2048

# ==========================================
# PYDANTIC RETRY
# ==========================================
ESG_MAX_RETRIES=2

# ==========================================
# NORMALIZATION / CHUNKING
# ==========================================
ESG_CHUNK_MAX_CHARS=6000
ESG_CHUNK_OVERLAP_CHARS=500

# ==========================================
# AUTOMATIC QUALITY CONTROL
# ==========================================
ESG_QC_MIN_CONFIDENCE=0.70
ESG_QC_MIN_LEXICAL_GROUNDING=0.45
ESG_QC_REQUIRE_SOURCE_SUPPORTED=true
